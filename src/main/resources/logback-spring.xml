<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <springProperty scope="context" name="appName"
                    source="spring.application.name" defaultValue="modular-erp-poc"/>
    <springProperty scope="context" name="env"
                    source="spring.profiles.active" defaultValue="local"/>

    <!-- Pretty console output: usado em local/test -->
    <appender name="STDOUT_PRETTY" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%X{tenantSlug:-}/%X{userId:-}] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- JSON structured output: usado em dev/staging/prod -->
    <appender name="STDOUT_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"app":"${appName}","env":"${env}"}</customFields>
            <includeMdcKeyName>tenantId</includeMdcKeyName>
            <includeMdcKeyName>tenantSlug</includeMdcKeyName>
            <includeMdcKeyName>userId</includeMdcKeyName>
            <includeMdcKeyName>sessionId</includeMdcKeyName>
            <includeMdcKeyName>requestId</includeMdcKeyName>
            <includeMdcKeyName>traceId</includeMdcKeyName>
            <includeMdcKeyName>spanId</includeMdcKeyName>
            <fieldNames>
                <timestamp>ts</timestamp>
                <message>msg</message>
                <thread>thread</thread>
                <logger>logger</logger>
                <level>level</level>
                <stackTrace>stack</stackTrace>
            </fieldNames>
            <includeContext>false</includeContext>
        </encoder>
    </appender>

    <springProfile name="local | test">
        <root level="INFO">
            <appender-ref ref="STDOUT_PRETTY"/>
        </root>
        <logger name="dev.dimi.erp" level="DEBUG"/>
    </springProfile>

    <springProfile name="dev | staging | prod">
        <root level="INFO">
            <appender-ref ref="STDOUT_JSON"/>
        </root>
        <logger name="dev.dimi.erp" level="INFO"/>
        <logger name="org.springframework.web" level="INFO"/>
        <logger name="org.hibernate.SQL" level="WARN"/>
        <logger name="org.hibernate.type.descriptor.sql.BasicBinder" level="WARN"/>
    </springProfile>

</configuration>
